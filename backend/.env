# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=Fin-Eye Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

# ── Database ────────────────────────────────────────────────────────────────────
# Make sure the DB exists first: createdb fin_eye
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fin_eye

# ── Redis ───────────────────────────────────────────────────────────────────────
# Start with: docker run -d -p 6379:6379 redis
REDIS_URL=redis://localhost:6379

# ── External APIs ───────────────────────────────────────────────────────────────
# Get a free key at https://finnhub.io
FINNHUB_API_KEY=d6ldde9r01qrq6i29m7gd6ldde9r01qrq6i29m80
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=77a2715b6594f71d7f396e16ed7b8db8

# ── JWT ─────────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-in-production

# ── Two-Factor Auth (TOTP) ──────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER_NAME=Fin-Eye

# ── Email (Resend) ──────────────────────────────────────────────────────────────
# Get a key at https://resend.com — leave blank to disable email sending
RESEND_API_KEY=
FROM_EMAIL=noreply@fin-eye.com
FRONTEND_URL=http://localhost:3000

# ── Model Store ─────────────────────────────────────────────────────────────────
MODEL_STORE_DIR=model_store

# ── OHLCV Pipeline ──────────────────────────────────────────────────────────────
OHLCV_LOOKBACK_YEARS=5
# Comma-separated list of symbols to track
OHLCV_SYMBOLS_DEFAULT=["AAPL","MSFT","GOOGL","AMZN","TSLA","SPY","QQQ","NVDA"]
