# ══════════════════════════════════════════════════════════════════════════════
# FIN-EYE BACKEND — ENVIRONMENT CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"
# Generate Fernet key:    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Fin-Eye Backend
APP_VERSION=0.1.0
# development | staging | production
ENVIRONMENT=development
# Set False in production — never expose /docs or stack traces
DEBUG=True
# Comma-separated allowed CORS origins (use ["*"] for dev only)
ALLOWED_ORIGINS=["http://localhost:3000","https://app.fin-eye.com"]

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:       postgresql://postgres:postgres@localhost:5432/fin_eye
# Render/Railway:  provided automatically
# Supabase:        postgres://[user]:[pass]@[host]:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fin_eye
# Async variant (same URL, different driver — used by SQLAlchemy async)
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fin_eye

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local:   redis://localhost:6379
# Upstash: rediss://[user]:[pass]@[host]:[port]
REDIS_URL=redis://localhost:6379
# Cache TTL in seconds (default 15 min = 900)
CACHE_TTL=900

# ── JWT & Auth ────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=2cdf934ffd0195e23172eaf153c75e0281a5ff5939797cd29d618eac213b3ae4
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set True to require auth on all endpoints (disable for dev/test)
REQUIRE_AUTH=False

# ── Two-Factor Auth (TOTP) ────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=NWy269HGhY5og3nwxWRtvq8Y2L2ual91NfjRYoCv8XA=
TOTP_ISSUER_NAME=Fin-Eye

# ── Email — Resend ────────────────────────────────────────────────────────────
# Get key at https://resend.com — free tier: 3000 emails/month
RESEND_API_KEY=
FROM_EMAIL=noreply@fin-eye.com
# Public URL of your frontend (used in email links and unsubscribe URLs)
FRONTEND_URL=http://localhost:3000

# ── Market Data APIs ──────────────────────────────────────────────────────────
# Finnhub — free tier: https://finnhub.io (used for news, earnings calendar)
FINNHUB_API_KEY=d6ldde9r01qrq6i29m7gd6ldde9r01qrq6i29m80
# Alpha Vantage — free tier: https://www.alphavantage.co (fallback OHLCV, fundamentals)
ALPHA_VANTAGE_API_KEY=8A2SUQ8NBD02UW7T
# Polygon.io — free tier: https://polygon.io (real-time quotes, WebSocket ticks)
POLYGON_API_KEY=g50OuVfpH_d1lpoNZHovyuvAuA8v6Dyy
# Tiingo — free tier: https://www.tiingo.com (alternative EOD data)
TIINGO_API_KEY=a6eee3a761d4655dfd112e6b7b73502cfdcff3be
# Quandl/Nasdaq Data Link — https://data.nasdaq.com (commodities, futures)
NASDAQ_DATA_LINK_API_KEY=

# ── Macro / Economic Data ──────────────────────────────────────────────────────
# FRED (St. Louis Fed) — free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=77a2715b6594f71d7f396e16ed7b8db8
# World Bank API — no key required (public)
# BLS (Bureau of Labor Statistics) — free: https://www.bls.gov/developers/
BLS_API_KEY=
# OECD API — no key required (public)
# ECB Statistical Data Warehouse — no key required (public)

# ── Crypto APIs ───────────────────────────────────────────────────────────────
# CoinGecko — free tier (no key needed for basic, key for pro)
COINGECKO_API_KEY=CG-Vz278UV9g6NB6uDK6oGpjaMH
# CoinMarketCap — https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=
# Binance (WebSocket market data) — https://www.binance.com/en/binance-api
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Commodities & Futures ──────────────────────────────────────────────────────
# barchart OnDemand (grain, energy, metals) — https://www.barchart.com/ondemand
BARCHART_API_KEY=
# CME Group Datamine — https://www.cmegroup.com/market-data/datamine.html
CME_API_KEY=

# ── Forex ─────────────────────────────────────────────────────────────────────
# Open Exchange Rates — https://openexchangerates.org (free: 1000 req/month)
OPEN_EXCHANGE_RATES_APP_ID=
# ExchangeRate-API — https://www.exchangerate-api.com (free: 1500 req/month)
EXCHANGE_RATE_API_KEY=f5364a84446bb25b96c2d29b
# Fixer.io — https://fixer.io (free: 100 req/month)
FIXER_API_KEY=5022f8efef3567ed662da40c46986290


# ── News & Sentiment ──────────────────────────────────────────────────────────
# NewsAPI — https://newsapi.org (free: 100 req/day)
NEWSAPI_KEY=423b94f87dee4778b45d6c321ef8ffa9
# GDELT Project — no key required (public)
# Reddit (PRAW) — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=fin-eye/1.0
# StockTwits — no key required for public feed (rate limited)
# Twitter/X API v2 — https://developer.twitter.com (Basic: $100/month)
TWITTER_BEARER_TOKEN=
# Benzinga — https://www.benzinga.com/apis
BENZINGA_API_KEY=

# ── AI / ML APIs ──────────────────────────────────────────────────────────────
# OpenAI — https://platform.openai.com (for GPT explanations / chat features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Anthropic — https://console.anthropic.com (alternative LLM)
ANTHROPIC_API_KEY=
# Groq — https://console.groq.com (fast inference, llama3)
GROQ_API_KEY=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
# Cohere — https://dashboard.cohere.com (embeddings, rerank)
COHERE_API_KEY=
# Pinecone — https://app.pinecone.io (vector DB for RAG / semantic search)
PINECONE_API_KEY=pcsk_2hQ7E6_CJsWca1wcTNhJkuPWj2FFGKqg5oguzmfCD6xDL6HrNrUvrYg3HGsQPgvGcG8Ac6
PINECONE_INDEX=fin-eye-docs
PINECONE_ENVIRONMENT=us-east-1

# ── Payments — Stripe ─────────────────────────────────────────────────────────
# Get at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook secret: stripe listen --forward-to localhost:8000/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Product/Price IDs (create in Stripe dashboard)
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PRICE_ID_INSTITUTIONAL_MONTHLY=
# Customer portal URL (set in Stripe dashboard → Billing portal)
STRIPE_CUSTOMER_PORTAL_URL=

# ── Payments — LemonSqueezy (alternative, simpler EU VAT handling) ────────────
# https://app.lemonsqueezy.com
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Product variant IDs for digital products (showcase/showroom)
LEMONSQUEEZY_VARIANT_INVESTMENT_TRACKER=
LEMONSQUEEZY_VARIANT_RETIREMENT_PLANNER=
LEMONSQUEEZY_VARIANT_EXPENSE_TRACKER=
LEMONSQUEEZY_VARIANT_TEEN_PLANNER=

# ── Payments — Paddle (global, handles VAT/GST automatically) ────────────────
# https://vendors.paddle.com
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_SANDBOX=True

# ── Auth — OAuth Providers ────────────────────────────────────────────────────
# Google OAuth (also used for Google login)
# https://console.developers.google.com → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# LinkedIn OAuth (optional — good for professional audience)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Storage — S3-compatible ───────────────────────────────────────────────────
# AWS S3 (model artifacts, report exports, user uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=fin-eye-storage
AWS_REGION=eu-west-1
# Cloudflare R2 (cheaper alternative, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fin-eye-storage
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ── CDN ───────────────────────────────────────────────────────────────────────
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ── Error Monitoring ──────────────────────────────────────────────────────────
# Sentry — https://sentry.io (free tier: 5000 errors/month)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Analytics (external, optional alongside self-hosted) ──────────────────────
# PostHog — https://app.posthog.com (open source, self-hostable)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
# Mixpanel — https://mixpanel.com
MIXPANEL_TOKEN=
# Plausible — https://plausible.io (privacy-first, no cookies)
PLAUSIBLE_DOMAIN=fin-eye.com

# ── Push Notifications ────────────────────────────────────────────────────────
# OneSignal — https://onesignal.com (web push, mobile push)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Firebase Cloud Messaging (FCM) — for mobile apps
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Webhooks (inbound — verify signatures before trusting) ────────────────────
# Stripe webhook endpoint: POST /webhooks/stripe
WEBHOOK_STRIPE_SIGNING_SECRET=
# LemonSqueezy webhook endpoint: POST /webhooks/lemonsqueezy
WEBHOOK_LEMONSQUEEZY_SIGNING_SECRET=
# Paddle webhook endpoint: POST /webhooks/paddle
WEBHOOK_PADDLE_PUBLIC_KEY=
# GitHub Actions webhook (for CD notifications)
WEBHOOK_GITHUB_SECRET=

# ── Notifications / Communication ─────────────────────────────────────────────
# Slack webhook — https://api.slack.com/messaging/webhooks (ops alerts)
SLACK_OPS_WEBHOOK_URL=
SLACK_ERROR_WEBHOOK_URL=
# Telegram bot (optional — for personal ops alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord webhook (optional)
DISCORD_WEBHOOK_URL=

# ── Compliance & Legal ────────────────────────────────────────────────────────
# Iubenda (cookie consent, privacy policy generation)
IUBENDA_API_KEY=
# Cookiebot
COOKIEBOT_DOMAIN_GROUP_ID=

# ── CRM / Support ─────────────────────────────────────────────────────────────
# Crisp (live chat, free tier) — https://crisp.chat
CRISP_WEBSITE_ID=
# Intercom — https://app.intercom.com
INTERCOM_APP_ID=
# HubSpot — https://app.hubspot.com
HUBSPOT_API_KEY=

# ── Internationalisation ──────────────────────────────────────────────────────
# DeepL API (translation for multi-language support)
DEEPL_API_KEY=

# ── App-Specific ──────────────────────────────────────────────────────────────
MODEL_STORE_DIR=model_store
BACKUP_DIR=backups
OHLCV_LOOKBACK_YEARS=5
# Default symbols pre-loaded into the system
OHLCV_SYMBOLS_DEFAULT=["AAPL","MSFT","GOOGL","AMZN","TSLA","SPY","QQQ","NVDA","META","BRK-B","JPM","GLD","TLT","BTC-USD","ETH-USD","GC=F","CL=F","EURUSD=X"]
# Rate limiting (requests per minute per IP for unauthenticated routes)
RATE_LIMIT_ANON=30
RATE_LIMIT_AUTH=120
RATE_LIMIT_API_KEY=300
# Feature flags (comma-separated)
FEATURE_FLAGS=crypto_mode,commodities_mode,forex_mode,digital_nomad_content,showroom
