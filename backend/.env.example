# ══════════════════════════════════════════════════════════════════════════════
# FIN-EYE BACKEND — ENVIRONMENT TEMPLATE
# ══════════════════════════════════════════════════════════════════════════════
# 1. Copy this file:  cp .env.example .env
# 2. Fill in values   (never commit .env — it's in .gitignore)
# 3. Generate secrets:
#    JWT_SECRET:          python -c "import secrets; print(secrets.token_hex(32))"
#    TOTP_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Fin-Eye Backend
ENVIRONMENT=development
DEBUG=True
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fin_eye
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fin_eye

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL=900

# ── JWT & Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_AUTH=False

# ── Two-Factor Auth ───────────────────────────────────────────────────────────
TOTP_ENCRYPTION_KEY=REPLACE_ME
TOTP_ISSUER_NAME=Fin-Eye

# ── Email — Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@fin-eye.com
FRONTEND_URL=http://localhost:3000

# ── Market Data ───────────────────────────────────────────────────────────────
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# ── Macro ─────────────────────────────────────────────────────────────────────
FRED_API_KEY=

# ── Crypto ───────────────────────────────────────────────────────────────────
COINGECKO_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── News & Sentiment ──────────────────────────────────────────────────────────
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=fin-eye/1.0

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Payments ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=fin-eye-storage
AWS_REGION=eu-west-1

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_OPS_WEBHOOK_URL=

# ── App Config ────────────────────────────────────────────────────────────────
MODEL_STORE_DIR=model_store
BACKUP_DIR=backups
OHLCV_LOOKBACK_YEARS=5
OHLCV_SYMBOLS_DEFAULT=["AAPL","MSFT","GOOGL","AMZN","TSLA","SPY","QQQ","NVDA"]
RATE_LIMIT_ANON=30
RATE_LIMIT_AUTH=120
