# ══════════════════════════════════════════════════════════════════════════════
# Fin-Eye — .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
venv/
env/
.venv/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Next.js ───────────────────────────────────────────────────────────────────
.next/
out/
build/
.swc/

# ── Environment variables ─────────────────────────────────────────────────────
# NEVER commit .env files — they contain secrets.
# Use .env.example as the template (already committed).
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local
frontend/.env

# ── IDEs and Editors ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS generated ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── ML Artifacts ─────────────────────────────────────────────────────────────
# Trained model binaries — large, machine-specific, regenerated by pipeline.
# The JSONL registry (model_registry.jsonl) IS committed — metadata only.
# model_registry_index.json is generated at runtime — do NOT commit.
model_store/
*.joblib
*.pkl
*.h5
*.pt
*.pth
backend/data/models/*.joblib
backend/data/models/*.pkl
backend/data/models/*.jsonl.bak
backend/data/models/model_registry_index.json

# ── MLflow ────────────────────────────────────────────────────────────────────
# mlflow.db = SQLite experiment store — local to each dev machine.
# mlartifacts/ = local copies of .joblib files.
# mlruns/ = legacy filesystem store (deprecated Feb 2026, kept for safety).
backend/data/mlflow.db
backend/data/mlartifacts/
backend/data/mlruns/
mlruns/
mlartifacts/

# ── Optuna (hyperparameter tuning — todos-v5) ────────────────────────────────
# Optuna SQLite study databases are local, regenerated per training run.
backend/data/optuna/
*.optuna.db
optuna_studies/

# ── SHAP outputs (todos-v5) ───────────────────────────────────────────────────
# SHAP value caches — large, regenerated from model + data.
backend/data/shap/
*.shap.pkl

# ── Database backups ──────────────────────────────────────────────────────────
# Auto-generated backup files — never commit DB dumps.
backend/backups/
*.sql
*.dump
*.db
# Exception: keep .db.example files if any exist
!*.db.example

# ── Logs ──────────────────────────────────────────────────────────────────────
# All log files across all subdirectories.
logs/
*.log
**/*.log

# Backend output/debug text files (generated by scripts, not source files).
# These are ad-hoc run outputs committed by mistake — exclude them.
backend/*.txt
backend/**/*.txt
# Exception: keep intentional docs like README files.
!backend/README.md

# ── Test & Coverage ───────────────────────────────────────────────────────────
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coverage
.tox/
nosetests.xml
pytest.xml

# ── Node / npm ────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ── TypeScript build ─────────────────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# ── Docker ────────────────────────────────────────────────────────────────────
# Docker generates these locally — not project source files.
.dockerignore
# Do NOT ignore docker-compose.yml or Dockerfile — those are source files.

# ── Alembic generated ─────────────────────────────────────────────────────────
# Alembic output logs from ad-hoc runs.
backend/alembic_*.txt
backend/alembic_*.log

# ── Agent / Claude reports ────────────────────────────────────────────────────
.claude/reports/model_report_*.md

# ── Temporary / scratch files ─────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.swp
*.orig
.cache/
tmp/
temp/

# ── Sensitive data files ──────────────────────────────────────────────────────
# Anything that could contain real financial data, user data, or credentials.
# Add specific paths here as the project grows.
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
# Exception: keep the MLflow DB ignore above (already listed), and allow
# tickers_predefined.json (it's curated source data, not sensitive).
!backend/data/tickers_predefined.json
